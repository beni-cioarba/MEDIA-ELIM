{
  "name": "iglesia-redes",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/generate-version.mjs",
    "prestart": "node scripts/generate-version.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-version.mjs && npm run check",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "version:generate": "node scripts/generate-version.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "posters": "node scripts/optimize-posters.mjs",
    "images": "node scripts/generate-image-sizes.mjs",
    "check:projection": "node scripts/check-projection-sizes.mjs",
    "check": "npm run i18n:check && npm run check:projection"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.7",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.0.0",
    "angularx-qrcode": "^22.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "jsdom": "^30.1.1",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.22.0 || ^24.15.0 || >=26.0.0"
  }
}
