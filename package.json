{
  "name": "iglesia-redes",
  "version": "2.3.0",
  "scripts": {
    "ng": "ng",
    "postinstall": "node scripts/generate-version.mjs",
    "prestart": "node scripts/generate-version.mjs && node scripts/generate-events-calendar.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/generate-version.mjs && node scripts/generate-events-calendar.mjs && npm run check",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "version:generate": "node scripts/generate-version.mjs",
    "calendar:events": "node scripts/generate-events-calendar.mjs",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "posters": "node scripts/optimize-posters.mjs",
    "images": "node scripts/generate-image-sizes.mjs",
    "images:budget": "node scripts/fit-image-budget.mjs",
    "check:projection": "node scripts/check-projection-sizes.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:drive": "node scripts/check-drive-links.mjs",
    "check": "npm run i18n:check && npm run check:projection && npm run check:content && npm run check:boundaries && node scripts/check-drive-links.mjs --offline && npm run test:scripts && npm run test:unit",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "test:unit": "ng test --watch=false",
    "e2e": "node scripts/e2e/smoke.mjs",
    "visual": "node scripts/e2e/visual-fingerprint.mjs",
    "pdf:familii": "node scripts/generate-family-pdfs.mjs",
    "impreuna:sync": "node scripts/sync-impreuna.mjs",
    "impreuna:push": "node scripts/impreuna-push.mjs",
    "bible:verses": "node scripts/generate-bible-verses.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@angular/service-worker": "^22.2.6",
    "@angular/ssr": "^22.2.7",
    "@ngrx/signals": "^22.0.1",
    "@ngx-translate/core": "^18.1.0",
    "@sentry/browser": "^11.14.0",
    "angularx-qrcode": "^22.0.1",
    "pdfjs-dist": "^6.5.438",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@sentry/cli": "^3.8.2",
    "jsdom": "^30.1.1",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^22.22.0 || ^24.15.0 || >=26.0.0"
  }
}
